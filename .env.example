# =============================================================
# SPHERE SOCIAL - PRODUCTION ARCHITECTURE CONFIGURATION
# =============================================================

# Authentication & Sessions (Authoritative JWT Secrets)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Cloudflare D1 Database Configuration
# Bound natively in Cloudflare Workers via wrangler.toml (env.DB)
# Or queried via D1 REST / Local SQLite file fallback (./data/sphere.db)
D1_DATABASE_ID=

# Cloudflare R2 Persistent Media Storage
# S3-compatible endpoints for real object storage without fake data
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# Email Provider for Transactional Password Resets (Brevo REST API v3)
# 1. Generate API key from Brevo Dashboard -> SMTP & API -> API Keys (starts with 'xkeysib-')
# 2. Add and verify your sender email under Senders & IP -> Senders in Brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=

# Netlify Deployment Option
# Set this in Netlify site environment if proxying to a deployed Cloudflare Worker
CLOUDFLARE_WORKER_URL=

# Reward Networks & Offerwall Credentials (Server-to-Server Postbacks)
# Set these when ready to activate live offerwall rewards:
ADGEM_APP_ID=
ADGEM_API_KEY=
OFFERWALL_KEY=
ESRNB_APP_ID=
ESRNB_API_KEY=

